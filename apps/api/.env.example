# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos
DATABASE_URL="postgresql://forecastia:forecastia@localhost:5432/forecastia?schema=public"

# Autenticación
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# IA (opcional - si no se define, se usa explicación local de fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
